# Echo Environment Variables Configuration
# Copy this file to .env or .env.local for development.
# If these variables are not provided, Echo automatically runs in MOCK DEMO MODE.

# Supabase Credentials (Database & Realtime)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Audio Provider Credentials (LiveKit or Daily API)
VITE_AUDIO_PROVIDER=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DAILY_API_KEY=

# LLM API Keys (Serverless functions only in /api - Gemini / OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Public App Base URL
VITE_APP_URL=
